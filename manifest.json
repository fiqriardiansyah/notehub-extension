{
  "manifest_version": 3,
  "name": "Notespacehub",
  "key": "",
  "version": "1.0.0",
  "description": "NotespaceHub browser extension",
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://notespacehub.com/*", "http://127.0.0.0:4173/*", "http://localhost:4173/*", "http://localhost:3000/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
